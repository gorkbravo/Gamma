# IBKR connection
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
IB_ACCOUNT=U15779203
IB_MARKET_DATA_MODE=delayed
IB_SNAPSHOT_TIMEOUT_SECONDS=2

# App settings
BASE_CURRENCY=EUR
AUTO_REFRESH_SECONDS=0
HIST_LOOKBACK_DAYS_DEFAULT=252
RESEARCH_MARKET_DATA_PROVIDERS=yfinance,ibkr
SITREP_MARKET_DATA_PROVIDERS=yfinance
RESEARCH_OVERVIEW_CACHE_SECONDS=300
SITREP_MARKET_DATA_CACHE_SECONDS=300
YFINANCE_TIMEOUT_SECONDS=10
FRED_API_KEY=
LOG_LEVEL=INFO
MOCK_DATA=false
PLOTLY_STATIC_RENDER=1

# SEC / EdgarTools identity
# TODO: Make this user-configurable in-app instead of relying on environment defaults.
GAMMA_SEC_USER_NAME=Gorka Bravo
GAMMA_SEC_USER_EMAIL=gorka.bravo1@gmail.com

# Copilot / OpenAI
OPENAI_API_KEY=
# Set to `mock` for offline local testing with no API key or credits.
GAMMA_COPILOT_PROVIDER=openai
GAMMA_COPILOT_MODEL=gpt-5.4
GAMMA_COPILOT_REASONING_EFFORT=medium
GAMMA_COPILOT_STORE_RESPONSES=true

# Commodities
# Keep `sample` for offline research data. Set `eia` after adding EIA_API_KEY for official US energy fundamentals.
# Set `ibkr` with a connected TWS session and futures market-data entitlements to construct read-only futures curves.
COMMODITIES_PROVIDER=sample
EIA_API_KEY=
COMMODITIES_CACHE_SECONDS=21600
IBKR_COMMODITIES_ENABLED=wti,brent,henry_hub,gasoline,heating_oil,gold,silver,copper
IBKR_COMMODITIES_STARTUP_ENABLED=wti
IBKR_COMMODITIES_ON_DEMAND=true
IBKR_COMMODITIES_SELECTED_CACHE_SECONDS=300
IBKR_COMMODITIES_CONTRACT_CACHE_SECONDS=21600
IBKR_COMMODITIES_CONTRACT_DEPTH=12
IBKR_COMMODITIES_HISTORY_DAYS=120
IBKR_COMMODITIES_QUOTE_TIMEOUT_SECONDS=2
IBKR_COMMODITIES_CONTRACT_TIMEOUT_SECONDS=12
IBKR_COMMODITIES_QUOTE_BATCH_SIZE=8
# Optional JSON object for futures root overrides, for example:
# {"brent":{"symbol":"BZ","exchange":"NYMEX","trading_class":"BZ"}}
IBKR_COMMODITIES_ROOT_OVERRIDES=
# Optional EIA APIv2 series overrides for the first-pass energy fundamentals adapter.
EIA_CRUDE_STOCKS_SERIES_ID=PET.WCESTUS1.W
EIA_GASOLINE_STOCKS_SERIES_ID=PET.WGTSTUS1.W
EIA_DISTILLATE_STOCKS_SERIES_ID=PET.WDISTUS1.W
EIA_NATGAS_STORAGE_SERIES_ID=NG.NW2_EPG0_SWO_R48_BCF.W
EIA_CRUDE_PRODUCTION_SERIES_ID=PET.WCRFPUS2.W
EIA_CRUDE_IMPORTS_SERIES_ID=PET.WCRIMUS2.W
EIA_CRUDE_EXPORTS_SERIES_ID=PET.WCREXUS2.W
EIA_REFINERY_INPUTS_SERIES_ID=PET.WCRRIUS2.W
EIA_REFINERY_UTILIZATION_SERIES_ID=PET.WPULEUS3.W
EIA_GASOLINE_PRODUCT_SUPPLIED_SERIES_ID=PET.WGFUPUS2.W
EIA_DISTILLATE_PRODUCT_SUPPLIED_SERIES_ID=PET.WDIUPUS2.W

# Maritime / AISstream
# Keep `sample` unless you want the Maritime tab to open a short live AISstream websocket sample.
MARITIME_PROVIDER=aisstream
AISSTREAM_API_KEY=
AISSTREAM_SAMPLE_SECONDS=6
AISSTREAM_MAX_MESSAGES=500
AISSTREAM_CACHE_SECONDS=30
# Optional JSON: [[[min_lat, min_lon], [max_lat, max_lon]]]
AISSTREAM_BOUNDING_BOXES=
